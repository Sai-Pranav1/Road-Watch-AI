# =============================================================================
# Road Damage Reporting Platform - Environment Variables
# =============================================================================

# Server settings
HOST=0.0.0.0
PORT=8000
BASE_URL=http://localhost:8000

# Supabase Cloud Configuration (Optional: leaving empty uses robust local SQLite fallback)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=road-damage-media

# AI Engine / YOLO Configuration
YOLO_MODEL_PATH=best.pt
CONF_THRESHOLD=0.45

# Password required to enter the Authority Dashboard
ADMIN_PASSWORD=your-strong-admin-password
